---
import fs from 'node:fs';
import path from 'node:path';
import TerminalLayout from '../../layouts/TerminalLayout.astro';
import JsonLd from '../../components/JsonLd.astro';

export async function getStaticPaths() {
  const jsonPath = path.join(process.cwd(), '../wildroots/wild-pharmacy/pharmacopoeia/plants.json');
  let raw = '[]';
  try {
    raw = fs.readFileSync(jsonPath, 'utf8');
  } catch(e) {
    console.warn("Could not load plants.json during build:", e);
  }
  const plants = JSON.parse(raw);
  
  return plants.map((plant) => {
    return {
      params: { slug: plant.key },
      props: { plant },
    };
  });
}

const { plant } = Astro.props;

// Meta tags preparation
const title = `${plant.common} (${plant.latin || 'Unknown'}) — Wild Pharmacy Pharmacopoeia`;
const ailmentsStr = Array.isArray(plant.ailments) ? plant.ailments.join(', ') : '';
const description = `Explore the medicinal properties of ${plant.common}, including its uses for ${ailmentsStr} and preparations.`;

const schema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": title,
  "description": description,
};
---

<TerminalLayout title={title} description={description}>
  <JsonLd schema={schema} />
  
  <article class="max-w-3xl mx-auto py-8">
    <div class="mb-6">
      <a href="/wild-pharmacy/pharmacopoeia/" class="text-leaf hover:text-terminal-amber font-mono text-sm transition-colors">&lt; return_to_pharmacopoeia</a>
    </div>

    <header class="border border-soil-700 bg-soil-800 rounded-xl p-8 mb-8 relative overflow-hidden">
      <div class="relative z-10">
        <h1 class="text-3xl md:text-5xl font-bold text-terminal-amber font-mono mb-2">{plant.common}</h1>
        {plant.latin && <h2 class="text-xl text-soil-100/70 italic font-serif mb-4">{plant.latin}</h2>}
        <div class="flex flex-wrap gap-2 text-xs font-mono">
          {plant.family && <span class="bg-soil-900 border border-soil-700 px-3 py-1 rounded-full text-leaf">Family: {plant.family}</span>}
          {plant.origin && <span class="bg-soil-900 border border-soil-700 px-3 py-1 rounded-full text-soil-100/70">Origin: {plant.origin}</span>}
        </div>
      </div>
    </header>

    <div class="grid md:grid-cols-2 gap-6 mb-8">
      <div class="border border-soil-700 bg-soil-800/50 rounded-xl p-6">
        <h3 class="text-leaf font-mono uppercase text-sm mb-4 border-b border-soil-700 pb-2">// Effects & Ailments</h3>
        <div class="space-y-4">
          {plant.effectPath && plant.effectPath.length > 0 && (
            <div>
              <h4 class="text-soil-100/60 text-xs uppercase mb-2">Primary Effects</h4>
              <div class="flex flex-wrap gap-2">
                {plant.effectPath.map((e) => <span class="text-sm text-soil-100 bg-soil-700/50 px-2 py-1 rounded">{e}</span>)}
              </div>
            </div>
          )}
          {plant.ailments && plant.ailments.length > 0 && (
            <div>
              <h4 class="text-soil-100/60 text-xs uppercase mb-2">Used For</h4>
              <div class="flex flex-wrap gap-2">
                {plant.ailments.map((a) => <span class="text-sm text-soil-100 bg-soil-700/50 px-2 py-1 rounded">{a}</span>)}
              </div>
            </div>
          )}
        </div>
      </div>

      <div class="border border-soil-700 bg-soil-800/50 rounded-xl p-6">
        <h3 class="text-leaf font-mono uppercase text-sm mb-4 border-b border-soil-700 pb-2">// Materia Medica</h3>
        <div class="space-y-4">
          {plant.partsUsed && plant.partsUsed.length > 0 && (
            <div>
              <h4 class="text-soil-100/60 text-xs uppercase mb-2">Parts Used</h4>
              <p class="text-soil-100 text-sm">{plant.partsUsed.join(', ')}</p>
            </div>
          )}
          {plant.preparations && plant.preparations.length > 0 && (
            <div>
              <h4 class="text-soil-100/60 text-xs uppercase mb-2">Preparations</h4>
              <p class="text-soil-100 text-sm">{plant.preparations.join(', ')}</p>
            </div>
          )}
          {plant.constituents && plant.constituents.length > 0 && (
            <div>
              <h4 class="text-soil-100/60 text-xs uppercase mb-2">Key Constituents</h4>
              <p class="text-soil-100 text-sm">{plant.constituents.join(', ')}</p>
            </div>
          )}
        </div>
      </div>
    </div>

    {plant.cautionsNote && (
      <div class="border border-red-900/50 bg-red-950/20 rounded-xl p-6 mb-8">
        <h3 class="text-red-400 font-mono uppercase text-sm mb-3">// Cautions</h3>
        <p class="text-soil-100/80 text-sm">{plant.cautionsNote}</p>
      </div>
    )}

    <!-- Funnel / CTAs -->
    <div class="mt-12 text-center p-8 border border-terminal-amber/30 bg-terminal-amber/5 rounded-2xl">
      <h3 class="text-terminal-amber font-mono text-lg mb-4">Discover {plant.common} in the Pharmacopoeia</h3>
      <p class="text-soil-100/80 text-sm mb-6 max-w-lg mx-auto">Explore the interactive 3D web to see how {plant.common} connects to other healing plants, ailments, and preparations in the Wild Pharmacy.</p>
      <div class="flex flex-col sm:flex-row justify-center gap-4">
        <a href="/wild-pharmacy/pharmacopoeia/" class="inline-block bg-terminal-amber text-soil-900 font-mono text-sm px-6 py-3 rounded hover:bg-ember transition-colors">
          &gt; explore_in_3d
        </a>
        <a href="https://bitsoil.gumroad.com/l/wild-pharmacy" target="_blank" rel="noopener" class="inline-block border border-leaf text-leaf font-mono text-sm px-6 py-3 rounded hover:bg-leaf hover:text-soil-900 transition-colors">
          &gt; download_full_guide
        </a>
      </div>
    </div>
  </article>
</TerminalLayout>
