---
import TerminalLayout from '../layouts/TerminalLayout.astro';
import { getCollection, render } from 'astro:content';

const loreRaw = (await getCollection('lore'))
  .filter((e) => !e.data.draft)
  .sort((a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf());
const lore = await Promise.all(
  loreRaw.map(async (e) => ({ ...e.data, Body: (await render(e)).Content }))
);

const notesRaw = (await getCollection('field-notes')).sort((a, b) => b.data.log - a.data.log);
const notes = await Promise.all(
  notesRaw.map(async (e) => ({ ...e.data, Body: (await render(e)).Content }))
);
---
<TerminalLayout title="The Compost">
  <section class="space-y-8">

    <div class="bg-soil-800 border border-soil-700 p-6 rounded-none">
      <h1 class="text-2xl text-terminal-amber font-bold mb-1">&gt; THE_COMPOST_LORE</h1>
      <p class="text-sm text-soil-100">Chronicles of the digitally shipwrecked — the Exiles who disconnected from the timeline to touch the living loam. We don't sell solutions here. We compost confusion.</p>
    </div>

    <!-- ============ EXILE LOGS ============ -->
    <div class="space-y-5">
      <h2 class="text-xs uppercase tracking-wider text-soil-700 font-bold">// EXILE_LOGS</h2>
      {lore.length === 0 && (
        <p class="text-sm text-soil-700 font-mono">&gt; no chronicles compiled yet. The compost is still warming.</p>
      )}
      {lore.map((entry) => {
        const Body = entry.Body;
        return (
          <article class="border border-soil-700 p-6 space-y-3">
            <div class="flex items-center justify-between gap-4 flex-wrap">
              <span class="text-[10px] uppercase tracking-wider text-terminal-amber font-bold border border-terminal-amber/40 px-2 py-1">exile: {entry.exile}</span>
              <span class="text-[10px] text-soil-700 font-mono">{entry.date}</span>
            </div>
            <h3 class="text-terminal-amber font-bold text-lg">{entry.title}</h3>
            <div class="logbody font-serif text-sm text-soil-100"><Body /></div>
          </article>
        );
      })}
    </div>

    <!-- ============ SYSTEM / FIELD LOGS ============ -->
    <div class="space-y-4">
      <h2 class="text-xs uppercase tracking-wider text-soil-700 font-bold">// FIELD_NOTES — SYS_LOG</h2>
      <div class="border border-soil-700 divide-y divide-soil-700">
        {notes.map((note) => {
          const Body = note.Body;
          return (
            <div class="p-5 space-y-2">
              <div class="text-[10px] text-soil-700 font-mono uppercase tracking-wider">log_{String(note.log).padStart(3, '0')} · {note.date}</div>
              <div class="logbody font-mono text-xs text-soil-100"><Body /></div>
            </div>
          );
        })}
      </div>
    </div>

    <div class="text-center pt-2">
      <a href="/the_syllabus" class="inline-block text-xs text-terminal-amber border border-terminal-amber/60 hover:bg-terminal-amber hover:text-soil-900 transition-colors font-mono px-4 py-2">&gt; the cure: boot the syllabus</a>
    </div>

  </section>
</TerminalLayout>

<style is:global>
  /* rendered-markdown styling, scoped to the log bodies (terminal theme) */
  .logbody p { margin: 0 0 0.75rem; line-height: 1.6; }
  .logbody p:last-child { margin-bottom: 0; }
  .logbody h1, .logbody h2, .logbody h3 { color: #FFB300; font-weight: 700; margin: 0 0 0.5rem; line-height: 1.3; }
  .logbody h1 { font-size: 1.05rem; }
  .logbody ul, .logbody ol { margin: 0 0 0.75rem 1.25rem; line-height: 1.6; }
  .logbody li { margin-bottom: 0.25rem; }
  .logbody blockquote { border-left: 2px solid rgba(255,179,0,0.45); padding-left: 0.85rem; font-style: italic; color: #FFB300; margin: 0 0 0.75rem; }
  .logbody a { color: #FFB300; text-decoration: underline; }
  .logbody code { font-family: 'JetBrains Mono', monospace; background: rgba(255,255,255,0.06); padding: 0 0.25rem; }
</style>
