---
import TerminalLayout from '../layouts/TerminalLayout.astro';
import JsonLd from '../components/JsonLd.astro';
import { MODULES } from '../lib/boot-core.mjs';

/** JSON-LD: one Course per Vital Earth OS module */
const courseListSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": "Vital Earth OS — The Four Modules",
  "description": "Four curriculum modules that recompile a digitally-exhausted mind through soil, food and living systems.",
  "url": "https://saraloosa.org/the_syllabus",
  "itemListElement": MODULES.map((m: { number: number; title: string; skill: string; lab: string; subtitle: string }) => ({
    "@type": "ListItem",
    "position": m.number,
    "item": {
      "@type": "Course",
      "name": m.title,
      "description": m.skill,
      "url": `https://saraloosa.org/the_syllabus#module-${m.number}`,
      "provider": {
        "@type": "EducationalOrganization",
        "name": "Saraloosa / BitSoil SageByte",
        "url": "https://saraloosa.org",
      },
    },
  })),
};
---
<TerminalLayout title="The Syllabus" description="The Vital Earth OS syllabus — four modules that recompile a digitally-exhausted mind. Run the Boot Sequence diagnostic to find your Exile archetype and where to begin." image="/img/comic/comicstrip-level1.webp">
  <JsonLd schema={courseListSchema} />
  <section class="space-y-8">

    <div class="grid md:grid-cols-[1fr_0.7fr] border border-soil-700 rounded-lg overflow-hidden bg-soil-800">
      <div class="p-6 md:p-7 flex flex-col justify-center space-y-2 order-2 md:order-1">
        <h1 class="text-2xl text-terminal-amber font-bold font-mono">&gt; THE_SYLLABUS // VITAL_EARTH_OS</h1>
        <p class="font-serif text-sm text-soil-100/90 leading-relaxed">Four modules that recompile a digitally-exhausted operating system. Don't know where to boot? Run the diagnostic — SageByte reads your runtime and routes you in.</p>
      </div>
      <div class="relative min-h-[150px] bg-soil-900 order-1 md:order-2 border-b md:border-b-0 md:border-l border-soil-700">
        <img src="/img/comic/comicstrip-level1.webp" alt="Wildroots comic strip — the garden heroes" class="absolute inset-0 w-full h-full object-cover opacity-85" loading="eager" />
      </div>
    </div>

    <!-- ============ BOOT SEQUENCE DIAGNOSTIC ============ -->
    <div class="border border-terminal-amber/40 p-6 space-y-4" id="boot">
      <h2 class="text-xs uppercase tracking-wider text-terminal-amber font-bold">// THE_BOOT_SEQUENCE</h2>
      <p class="font-serif text-sm text-soil-100">Describe how you're running lately — the fatigue, the loops, the thing that's off. SageByte will match you to your Exile archetype and the module that recompiles it.</p>

      <label for="bootInput" class="sr-only">Describe how you are running lately — fatigue, loops, what is off</label>
      <textarea id="bootInput" name="bootInput" rows="3" maxlength="600"
        aria-describedby="bootHint"
        class="w-full bg-soil-900 border border-soil-700 focus:border-terminal-amber outline-none text-soil-100 font-mono text-sm p-3 rounded-none placeholder:text-soil-700 focus-visible:outline-none"
        placeholder="e.g. I doomscroll till 2am, my brain feels fried, and no productivity hack ever sticks…"></textarea>
      <p id="bootHint" class="text-[10px] text-soil-700 font-mono">Max 600 characters. Press Ctrl+Enter or Cmd+Enter to run.</p>

      <button id="bootBtn" type="button" aria-controls="bootResult"
        class="text-xs text-terminal-amber border border-terminal-amber/60 hover:bg-terminal-amber hover:text-soil-900 transition-colors font-mono px-4 py-2 disabled:opacity-40 focus-visible:outline focus-visible:outline-2 focus-visible:outline-terminal-amber">
        &gt; run_diagnostic
      </button>

      <div id="bootResult" role="status" aria-live="polite" aria-atomic="true" class="text-sm"></div>
    </div>

    <!-- ============ THE MODULES ============ -->
    <div class="space-y-4">
      <h2 class="text-xs uppercase tracking-wider text-soil-700 font-bold">// THE_FOUR_MODULES</h2>
      <div class="grid md:grid-cols-2 gap-4">
        {MODULES.map((m) => (
          <div id={`module-${m.number}`} class="border border-soil-700 p-5 space-y-2 scroll-mt-24">
            <div class="text-[10px] uppercase tracking-wider text-soil-700 font-bold">// 0{m.number} / {m.subtitle}</div>
            <h3 class="text-terminal-amber font-bold text-lg">{m.title}</h3>
            <p class="font-serif text-sm text-soil-100">{m.skill}</p>
            <p class="text-xs text-soil-100/80"><span class="text-terminal-amber">lab:</span> {m.lab}</p>
            <p class="text-xs italic text-terminal-amber/90 border-l-2 border-terminal-amber/40 pl-3 mt-2">"{m.keyPhrase}"</p>
          </div>
        ))}
      </div>
    </div>

  </section>
</TerminalLayout>

<script>
  const input = document.getElementById('bootInput') as HTMLTextAreaElement;
  const btn = document.getElementById('bootBtn') as HTMLButtonElement;
  const out = document.getElementById('bootResult') as HTMLDivElement;
  const esc = (s: unknown) => String(s == null ? '' : s).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c] as string));

  function render(v: any) {
    if (v.crisis) {
      out.innerHTML = `<div class="border border-terminal-amber p-4 mt-2 text-soil-100 font-serif leading-relaxed">
        Some loops are too heavy for compost and code alone. If you're in real distress, reach a human you trust or a local helpline first — the soil will keep, and it'll still be here, slow and patient, when you're ready.</div>`;
      return;
    }
    const n = v.moduleNumber;
    out.innerHTML = `
      <div class="border border-terminal-amber/60 bg-soil-900 p-4 mt-2 space-y-3 font-mono">
        <div class="text-[10px] uppercase tracking-wider text-soil-700">// diagnostic_complete</div>
        <div class="text-terminal-amber font-bold text-lg">${esc(v.glyph)} ${esc(v.archetype)}</div>
        <p class="font-serif text-sm text-soil-100 leading-relaxed">${esc(v.diagnosis)}</p>
        <p class="text-xs italic text-terminal-amber/90 border-l-2 border-terminal-amber/40 pl-3">"${esc(v.keyPhrase)}"</p>
        <div class="text-xs text-soil-100/80"><span class="text-terminal-amber">prescription:</span> ${esc(v.prescription)}</div>
        <a href="#module-${n}" class="inline-block text-xs text-terminal-amber border border-terminal-amber/60 hover:bg-terminal-amber hover:text-soil-900 transition-colors px-4 py-2 mt-1">&gt; boot Module 0${n}: ${esc(v.module?.title)}</a>
      </div>`;
    const card = document.getElementById('module-' + n);
    if (card) {
      card.classList.add('border-terminal-amber');
      card.classList.remove('border-soil-700');
    }
  }

  async function go() {
    const text = input.value.trim();
    if (!text) { input.focus(); return; }
    btn.disabled = true;
    out.innerHTML = `<div class="text-terminal-amber/80 font-mono text-xs mt-2 animate-pulse">&gt; reading runtime… compiling diagnosis…</div>`;
    try {
      const r = await fetch('/api/boot', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ input: text }) });
      const data = await r.json();
      if (!r.ok) throw new Error(data.error || 'SYS_NODE went quiet.');
      render(data);
    } catch (err: any) {
      out.innerHTML = `<div class="text-red-400 font-mono text-xs mt-2">! ${esc(err.message || 'SYS_NODE went quiet.')}</div>`;
    } finally {
      btn.disabled = false;
    }
  }
  btn.addEventListener('click', go);
  input.addEventListener('keydown', (e) => { if (e.key === 'Enter' && (e.metaKey || e.ctrlKey)) go(); });
</script>
