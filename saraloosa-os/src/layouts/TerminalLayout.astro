---
import '../styles/global.css';
import JsonLd from '../components/JsonLd.astro';

const {
  title,
  description = "BitSoil SageByte — where compost meets code. A living learning world of soil, food and the digitally shipwrecked: brew kitchen scraps into elixirs, ask the Soil Oracle, run the burnout diagnostic, and play the Barnyard Arcade.",
  image = "/img/infog/the-circle-of-vitality-infographic.webp",
} = Astro.props;
const site = "https://saraloosa.org";
const canonical = new URL(Astro.url.pathname, site).href;
const ogImage = new URL(image, site).href;
const fullTitle = `${title} // Saraloosa OS`;

/** Site-wide Organisation schema — injected on every page. */
const orgSchema = {
  "@context": "https://schema.org",
  "@type": "EducationalOrganization",
  "name": "Saraloosa / BitSoil SageByte",
  "alternateName": "BitSoil SageByte",
  "url": site,
  "logo": `${site}/favicon.svg`,
  "description": "A living learning world of soil, food and the digitally shipwrecked — educational storytelling where compost meets code.",
  "sameAs": ["https://saraloosa.org"],
};

// Umami analytics — env-gated, privacy-friendly, free. Set UMAMI_WEBSITE_ID in
// the Netlify site env to switch it on; nothing renders until then.
const umamiId = import.meta.env.UMAMI_WEBSITE_ID;
const umamiSrc = import.meta.env.UMAMI_SRC || "https://cloud.umami.is/script.js";
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <script is:inline>try{if(localStorage.getItem('theme')==='os')document.documentElement.dataset.theme='os'}catch(e){}</script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#f3ecd6" />
    <meta name="robots" content="index, follow" />
    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="BitSoil SageByte // Saraloosa OS" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <!-- Structured data -->
    <JsonLd schema={orgSchema} />
    {umamiId && <script defer src={umamiSrc} data-website-id={umamiId} is:inline></script>}
  </head>
  <body class="bg-soil-900 text-soil-100 min-h-screen font-mono p-4 md:py-8 md:px-[3vw] flex flex-col selection:bg-terminal-amber selection:text-soil-900">
    <!-- Skip-to-content for keyboard/AT users -->
    <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:bg-terminal-amber focus:text-soil-900 focus:px-4 focus:py-2 focus:font-mono focus:text-xs focus:rounded focus:outline-none">
      Skip to main content
    </a>

    <header class="site-header border border-soil-700 rounded-full bg-soil-800/80 backdrop-blur px-5 py-3 mb-8 flex flex-col gap-3 sm:flex-row sm:justify-between sm:items-center text-sm text-soil-100">
      <div>
        <span class="os-only"><span class="text-leaf font-bold">SYS_NODE:</span> saraloosa.org // online</span><a href="/" class="sp-only flex items-center gap-2 no-underline"><svg width="28" height="28" viewBox="0 0 32 32" aria-hidden="true"><circle cx="16" cy="16" r="6.5" fill="#f2b632"/><g stroke="#e0891f" stroke-width="2" stroke-linecap="round"><path d="M16 2v4M16 26v4M2 16h4M26 16h4M6 6l3 3M23 23l3 3M6 26l3-3M23 9l3-3"/></g><path d="M16 30c-1-6 2-10 7-11-1 5-3 9-7 11z" fill="#3a7a3c"/></svg><span class="font-display text-base font-semibold text-leaf-deep">saraloosa</span><span class="text-soil-100/60">· BitSoil SageByte</span></a>
      </div>
      <nav aria-label="Site navigation" class="flex flex-wrap gap-x-4 gap-y-1">
        <a href="/" class="hover:text-terminal-amber transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-terminal-amber">/root</a>
        <a href="/the_syllabus" class="hover:text-terminal-amber transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-terminal-amber">/syllabus</a>
        <a href="/the_compost" class="hover:text-terminal-amber transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-terminal-amber">/compost</a>
        <a href="/arcade" class="hover:text-terminal-amber transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-terminal-amber">/arcade</a>
        <a href="https://www.youtube.com/@bitbarnbyte" target="_blank" rel="noopener" class="hover:text-terminal-amber transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-terminal-amber">▶ youtube&#8599;</a>
        <button type="button" class="theme-toggle" id="theme-toggle" aria-label="Switch site look"><span class="sp-only">&gt;_ OS look</span><span class="os-only">☀ solarpunk</span></button>
      </nav>
    </header>

    <main id="main-content" class="flex-grow w-full">
      <slot />
    </main>

    <footer class="border-t border-soil-700 mt-12 pt-4 text-center text-xs text-soil-100/60 tracking-wide">
      <span class="sp-only">🌱 grown in sunlight · composting confusion since 2026 · </span><span class="os-only">SYS_VERSION: 1.0.0 // STATUS: COMPOSTING_CONFUSION // </span><a href="https://www.youtube.com/@bitbarnbyte" target="_blank" rel="noopener" class="hover:text-terminal-amber transition-colors">youtube @bitbarnbyte</a> · © 2026 Liezl Coetzee
    </footer>
    <script is:inline>
    document.getElementById('theme-toggle').addEventListener('click',function(){
      var r=document.documentElement, os=r.dataset.theme!=='os';
      if(os) r.dataset.theme='os'; else delete r.dataset.theme;
      try{localStorage.setItem('theme',os?'os':'solarpunk')}catch(e){}
    });
  </script>
  </body>
</html>
