# saraloosa-os — environment variables
# Copy to .env.local for local dev (never commit .env.local)
#
# Already-provisioned values live here (paths only — never the values):
#   GOOGLE_GENERATIVE_AI_API_KEY  -> ../../gemini-voice-agents/gem-voice/.env.local
#   PINECONE_API_KEY              -> ../../sociable.systems/.env.local
# Both are also set in Netlify (project: bitbarnbytes / saraloosa.org).
# This repo's own .env (gitignored) also carries them for local builds.

# ── Core: Soil Oracle + agents (Gemini, required) ───────────────────────────
GOOGLE_GENERATIVE_AI_API_KEY=     # value in gem-voice/.env.local; set in Netlify

# ── Tier-1: Pinecone RAG (Soil Oracle vector grounding) ─────────────────────
# Enables vector-search grounding; Oracle falls back to static corpus.json if absent.
# Run `npm run index:build` once after setting this to populate the saraloosa-soil index.
PINECONE_API_KEY=                 # value in sociable.systems/.env.local; set (secret) in Netlify

# ── HuggingFace fallback (optional, if Gemini unavailable) ──────────────────
HF_TOKEN=
# HF_MODEL=openai/gpt-oss-120b:cerebras   # default; override if needed

# ── Tier-2: Langfuse observability ──────────────────────────────────────────
# All three required to enable tracing — omit any one to run in no-op mode
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ── Tier-2: Cloudinary image CDN ────────────────────────────────────────────
# Set either PUBLIC_ (Astro exposes to browser) or plain (server-only).
# If absent, cld() returns the local path unchanged — no CDN, no breakage.
PUBLIC_CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_CLOUD_NAME=           # server-only fallback
CLOUDINARY_SITE_ORIGIN=https://saraloosa.org   # used to build fetch URLs
