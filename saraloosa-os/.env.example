# saraloosa-os — environment variables
# Copy to .env.local for local dev (never commit .env.local)

# ── Required for Soil Oracle (Gemini) ─────────────────────────────────
GOOGLE_GENERATIVE_AI_API_KEY=your-gemini-api-key

# ── Soil Oracle: Pinecone RAG upgrade (Tier-1) ────────────────────────
# Set this to enable vector-search grounding; Oracle falls back to the
# static corpus.json if absent.  Run `npm run index:build` once after
# setting this to populate the saraloosa-soil index.
PINECONE_API_KEY=your-pinecone-api-key

# ── HuggingFace fallback (optional) ───────────────────────────────────
HF_TOKEN=your-hf-token
# HF_MODEL=openai/gpt-oss-120b:cerebras   # default; override if needed
