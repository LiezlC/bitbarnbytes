# ── Core (required) ─────────────────────────────────────────────────────────
# Google Gemini API key — primary LLM provider for all four agents
GOOGLE_GENERATIVE_AI_API_KEY=

# HuggingFace token — fallback if Gemini is unavailable (optional)
HF_TOKEN=
HF_MODEL=                          # default: openai/gpt-oss-120b:cerebras

# ── Tier-2: Langfuse observability ──────────────────────────────────────────
# All three required to enable tracing — omit any one to run in no-op mode
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com
# Alternative: LANGFUSE_BASE_URL=https://cloud.langfuse.com

# ── Tier-2: Cloudinary image CDN ────────────────────────────────────────────
# Set either PUBLIC_ (Astro exposes to browser) or plain (server-only).
# If absent, cld() returns the local path unchanged — no CDN, no breakage.
PUBLIC_CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_CLOUD_NAME=           # server-only fallback
CLOUDINARY_SITE_ORIGIN=https://saraloosa.org   # used to build fetch URLs
